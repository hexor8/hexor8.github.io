					UserControls = ordered() { seed = { INP_MaxAllowed = 1000000, INP_Integer = false, INPID_InputControl = "ButtonControl", BTNCS_Execute = "+0", INP_MaxScale = 1, INP_MinScale = 0, INP_MinAllowed = -1000000, LINKID_DataType = "Number", ICS_ControlPage = "Controls", ICD_Width = 1, LINKS_Name = "Random Seed" }, DetectRange = { LINKID_DataType = "Number", INPID_InputControl = "ButtonControl", BTNCS_Execute = "local MAX_HOPS = 64\nlocal m = comp.ActiveTool\nif not m then print('Hyperslide: select the Hyperslide_Pro macro first') return end\nlocal tst\nfor _, c in pairs(m:GetChildrenList() or {}) do\n  if c.Name:gsub('_%d+$', '') == 'HS_Tst' then tst = c break end\nend\nif not tst then print('Hyperslide: HS_Tst not found inside the selected tool') return end\nlocal function upstream(t)\n  for _, id in ipairs({'Input', 'Background', 'Source', 'MainInput1'}) do\n    local i = t[id]\n    if i and i.GetConnectedOutput then\n      local o = i:GetConnectedOutput()\n      if o then return o:GetTool() end\n    end\n  end\n  for _, i in pairs(t:GetInputList() or {}) do\n    if i:GetAttrs().INPS_DataType == 'Image' then\n      local o = i:GetConnectedOutput()\n      if o then return o:GetTool() end\n    end\n  end\nend\nlocal cur, hops, src = upstream(tst) or upstream(m), 0, nil\nwhile cur and hops < MAX_HOPS do\n  if cur:GetAttrs().TOOLS_RegID == 'MediaIn' then src = cur break end\n  cur = upstream(cur)\n  hops = hops + 1\nend\nif not src then print('Hyperslide: no MediaIn found upstream') return end\nlocal ex = tst.SourceTime:GetExpression()\nif not ex or ex == '' then print('Hyperslide: HS_Tst SourceTime has no expression to update') return end\nlocal name = src.Name:gsub('%%', '%%%%')\nlocal nex = ex:gsub('[%w_]+(%.ClipTime)', name .. '%1')\ncomp:StartUndo('Hyperslide Detect Range')\ntst.SourceTime:SetExpression(nex)\ncomp:EndUndo(true)\nprint('Hyperslide: frame range now read from ' .. src.Name)", INP_External = false, INP_Passive = true, ICS_ControlPage = "Controls", ICD_Width = 1, LINKS_Name = "Detect Range" } }
				}
			},
		}
	},
	ActiveTool = "Hyperslide_Pro"
}